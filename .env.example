APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://djm_user:change-me@localhost:5432/djm_dev
TEST_DATABASE_URL=postgresql+psycopg://djm_user:change-me@localhost:5432/djm_test
FRONTEND_BASE_URL=http://localhost:5173
# Per-IP limit on register, login, forgot-password and resend-verification. End-to-end tests raise it.
AUTH_RATE_LIMIT=5/minute
SESSION_TTL_HOURS=336
# console (log emails, development only) | smtp (real delivery; required in production) | fake (tests)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# Per-IP limit on CV uploads.
UPLOAD_RATE_LIMIT=10/minute
# Per-IP limit on vacancy reports.
REPORT_RATE_LIMIT=10/hour
# Per-IP limit on applications (each one copies a CV file).
APPLY_RATE_LIMIT=30/hour
MAX_CV_BYTES=5242880
# Version of the Terms and Privacy Policy users agree to. Change it when the texts change.
POLICY_VERSION=2026-11-draft
ADMIN_EMAIL=
