{$SITE_ADDRESS} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
		# Pages must be re-checked on every visit so a new deploy shows up; /assets files have
		# hashed names and can be cached.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
